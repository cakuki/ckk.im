---
const { date, format = "date" } = Astro.props;
---

<datetime datetime={date} data-format={format} data-date={date}>
	{/* Initial server rendered content will be replaced */}
	{new Date(date).toLocaleDateString()}
</datetime>

<script>
	function formatDate(dateString: string, format: "date" | "full" = "date") {
		const date = new Date(dateString);

		if (format === "date") {
			return date.toLocaleDateString(undefined, {
				year: "numeric",
				month: "long",
				day: "numeric",
			});
		} else if (format === "full") {
			return date.toLocaleString(undefined, {
				year: "numeric",
				month: "long",
				day: "numeric",
				hour: "2-digit",
				minute: "2-digit",
				second: "2-digit",
				timeZoneName: "short",
			});
		}

		return date.toLocaleDateString();
	}

	// Update all datetime elements when the page loads
	document.addEventListener("DOMContentLoaded", () => {
		const datetimeElements = document.querySelectorAll("datetime[data-date]");

		datetimeElements.forEach((element) => {
			const date = element.getAttribute("data-date");
			const format = element.getAttribute("data-format");

			// Format the visible text
			element.textContent = formatDate(date, "date");

			// Set the title attribute for tooltip
			if (format === "full" || format === "date") {
				element.setAttribute("title", formatDate(date, "full"));
			}
		});
	});
</script>
