---
import Page from "./Page.astro";
import ClientDateTime from "../components/ClientDateTime.astro";

const { title, pubDate, lastUpdated } = Astro.props.frontmatter;
---

<Page title={title}>
	<article>
		<header>
			<h1>{title}</h1>
			<p>
				By <a href="/about">Can Kutlu Kınay</a> on
				<ClientDateTime date={pubDate} format="full" />
				{
					lastUpdated && (
						<>
							{" "}
							· Last updated on{" "}
							<ClientDateTime date={lastUpdated} format="full" />
						</>
					)
				}
			</p>
		</header>
		<slot />
	</article>
</Page>

<style>
	article {
		max-width: 40rem;
		margin: 0 auto;
	}
	header {
		margin-bottom: 2rem;
	}
	footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
</style>
